# ── Database ────────────────────────────────────────────────────────────────
# MySQL. Locally this points at XAMPP's MySQL (default: user "root", no password).
# To move to a remote DB later, change ONLY this line — no code changes required.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/fitflow"

# ── Auth / Sessions ─────────────────────────────────────────────────────────
# 32+ char random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── Seed Manager account (used by `npm run db:seed`) ─────────────────────────
SEED_MANAGER_USERNAME="manager"
SEED_MANAGER_PASSWORD="ChangeMe123!"

# ── File storage ────────────────────────────────────────────────────────────
# Absolute or relative path where uploaded exercise videos are stored on the
# server. Kept OUTSIDE /public so files are only reachable via the token route.
UPLOAD_DIR="./storage/videos"
# Generated course PDFs (kept out of /public; reachable only via share token).
COURSE_PDF_DIR="./storage/courses"
# Whole-database JSON snapshots (manual + one automatic per day). Manager only.
BACKUP_DIR="./storage/backups"

# ── Public base URL ─────────────────────────────────────────────────────────
# Used for the clickable exercise-video links embedded in generated PDFs, and
# for the course share link. MUST be a public address once the site is hosted —
# a localhost value will not open on a member's phone.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── WhatsApp delivery ───────────────────────────────────────────────────────
# Sends the course PDF to the member as a real document attachment.
# Turn this on AFTER the site is hosted publicly, then pair the gym's WhatsApp
# number once by scanning the QR code on the Settings page.
# Uses the WhatsApp Web protocol (unofficial) — always use a dedicated gym
# number, never a personal one.
WHATSAPP_ENABLED="false"
# Country code applied to locally-formatted numbers (Iraq = 964).
WHATSAPP_COUNTRY_CODE="964"
# Where the WhatsApp pairing credentials are kept. Never commit this folder.
WHATSAPP_AUTH_DIR="./storage/whatsapp-auth"

# ── Gate (turnstile) ────────────────────────────────────────────────────────
# The turnstile is driven by a ZKTeco C3 access panel on the LAN. The bridge
# (`npm run gate`) runs as its own process on the gym computer: it watches the
# panel for card taps, checks the member's subscription in FitFlow and opens
# the door. Cards are NOT registered on the panel — FitFlow decides.
GATE_ENABLED="false"
# Panel address (factory default 192.168.1.201:4370, empty password).
GATE_PANEL_HOST="192.168.1.201"
GATE_PANEL_PORT="4370"
GATE_PANEL_PASSWORD=""
# Which door output the entry reader belongs to (1 or 2 on a C3-200).
GATE_DOOR="2"
# Seconds the relay stays open per allowed tap (1–254).
GATE_OPEN_SECONDS="3"
# How often the bridge asks the panel for new taps (ms).
GATE_POLL_MS="300"
