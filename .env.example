# FitFlow environment
#
# The system runs in two places:
#   1. The website on Vercel — needs everything under "Hosted app" below.
#   2. Two workers on the gym computer (`npm run gate`, `npm run whatsapp`) —
#      need the same DATABASE_URL plus their own sections at the bottom.
# Never commit a filled-in copy of this file.

# ══════════════════════════ Hosted app (Vercel) ══════════════════════════

# ── Database: Supabase Postgres ─────────────────────────────────────────────
# DATABASE_URL is the transaction-mode pooler (port 6543) every runtime uses.
# DIRECT_URL is the session-mode port (5432); Prisma needs it for migrations,
# which cannot run through pgbouncer.
# Pick a Supabase region close to the gym — it is paid for on every request.
# connection_limit is per running instance: too low and the parallel queries a
# page makes queue up behind each other, too high and many instances together
# exhaust the pooler. 5 suits both a serverless function and a local worker.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth / Sessions ─────────────────────────────────────────────────────────
# 32+ char random secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everyone out. Use a different value in production.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── File storage: Supabase Storage ──────────────────────────────────────────
# Exercise videos and database snapshots live in two PRIVATE buckets named
# `videos` and `backups`. The browser uploads videos straight to Supabase with
# a signed URL, because a hosted function cannot pass more than 4.5 MB.
# The secret key bypasses row-level security — server-side only, never expose it.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# ── Public base URL ─────────────────────────────────────────────────────────
# Used for the exercise-video links inside generated PDFs and for the course
# share link.
#
# On Vercel this can be left unset: the app falls back to the platform's own
# production domain, and a stale "localhost" here is ignored rather than
# producing share links no member can open. Set it explicitly once a custom
# domain is attached.
#
# The WhatsApp worker on the gym computer has no such fallback — it must be
# given the real address in its own .env.
NEXT_PUBLIC_APP_URL="https://fitflow.vercel.app"

# ── Seed Manager account (used by `npm run db:seed`) ────────────────────────
SEED_MANAGER_USERNAME="manager"
SEED_MANAGER_PASSWORD="ChangeMe123!"

# ══════════════════ Workers on the gym computer only ══════════════════
# These are NOT needed on Vercel. Put them in the .env on the gym computer,
# together with DATABASE_URL, SESSION_SECRET and NEXT_PUBLIC_APP_URL above.

# ── WhatsApp delivery (`npm run whatsapp`) ──────────────────────────────────
# Sends each saved course to the member as a real PDF attachment. The website
# only queues the request; this worker does the sending, so it must be running
# on a computer that is on. Pair the gym number once by scanning the QR code
# the worker prints on its first run.
# Uses the WhatsApp Web protocol (unofficial) — always use a dedicated gym
# number, never a personal one.
WHATSAPP_ENABLED="false"
# Country code applied to locally-formatted numbers (Iraq = 964).
WHATSAPP_COUNTRY_CODE="964"
# Where the WhatsApp pairing credentials are kept. Never commit this folder.
WHATSAPP_AUTH_DIR="./storage/whatsapp-auth"
# How often the outbox is checked (ms).
WHATSAPP_POLL_MS="5000"

# ── Gate / turnstile (`npm run gate`) ───────────────────────────────────────
# The turnstile is driven by a ZKTeco C3 access panel on the gym's LAN. The
# bridge watches it for card taps, checks the member's subscription and opens
# the door. Cards are NOT registered on the panel — FitFlow decides.
GATE_ENABLED="false"
# Panel address (factory default 192.168.1.201:4370, empty password).
GATE_PANEL_HOST="192.168.1.201"
GATE_PANEL_PORT="4370"
GATE_PANEL_PASSWORD=""
# Which door output the entry reader belongs to (1 or 2 on a C3-200).
GATE_DOOR="2"
# Seconds the relay stays open per allowed tap (1–254).
GATE_OPEN_SECONDS="3"
# How often the bridge asks the panel for new taps (ms).
GATE_POLL_MS="300"

# ── Data migration only (`npm run migrate-mysql`) ───────────────────────────
# The old local MySQL database, read once when moving to Supabase.
# MYSQL_URL="mysql://root:@localhost:3306/fitflow"

# ── Master ────────────────────────────────────────────────────────────────
# The secret path segment for the owner's sign-in: /access/<MASTER_GATE>.
# Anything else under /access answers as "not found", so this value is the
# only thing standing in front of that page — make it long and random, and
# never commit the real one. At least 12 characters or the page stays shut.
# Create the account itself with:  npm run master -- <username> <password>
MASTER_GATE=""
