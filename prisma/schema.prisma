// FitFlow — data model
// Database: MySQL (XAMPP locally). Move to a remote server by changing only
// DATABASE_URL — no code changes required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────── Enums ──────────────────────────────

enum Role {
  MANAGER
  RECEPTION
  CAPTAIN
}

enum PaymentMethod {
  CASH
  DEFERRED
}

enum Gender {
  MALE
  FEMALE
}

enum ExpenseCategory {
  RENT
  SALARY
  EQUIPMENT
  MAINTENANCE
  UTILITIES
  SUPPLIES
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  FROZEN
  CANCELLED
}

enum ActivityAction {
  REGISTER_MEMBER
  UPDATE_MEMBER
  DELETE_MEMBER
  RENEW_SUBSCRIPTION
  RECEIVE_PAYMENT
  FREEZE_SUBSCRIPTION
  UNFREEZE_SUBSCRIPTION
  CANCEL_SUBSCRIPTION
  CREATE_PLAN
  UPDATE_PLAN
  ARCHIVE_PLAN
  CREATE_TRAINING_COURSE
  CREATE_NUTRITION_COURSE
  SAVE_TEMPLATE
  UPDATE_TEMPLATE
  DELETE_TEMPLATE
  ADD_VIDEO
  EDIT_VIDEO
  DELETE_VIDEO
  CREATE_USER
  UPDATE_USER
  TOGGLE_VIDEO_PERMISSION
  CREATE_EXPENSE
  DELETE_EXPENSE
  CREATE_DEBT
  RECEIVE_DEBT_PAYMENT
  DELETE_DEBT
  CREATE_BACKUP
  RESTORE_BACKUP
}

enum NotificationType {
  EXPIRING_SOON
  EXPIRING_TODAY
  DEFERRED_BALANCE
  FROZEN_SUBSCRIPTION
  MEMBER_REGISTERED_DEFERRED
}

// ────────────────────────────── Accounts ──────────────────────────────

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  displayName    String
  hashedPassword String
  role           Role
  isActive       Boolean  @default(true)
  // Per-captain permission: may the captain add videos to the library?
  canAddVideos   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Who created this account (manager). Self-relation.
  createdById  String?
  createdBy    User?   @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreator")

  activityLogs      ActivityLog[]
  videosAdded       Video[]
  subscriptionsMade Subscription[]
  paymentsReceived  Payment[]
  freezesApplied    FreezeRecord[]
  trainingCourses   TrainingCourse[]
  nutritionCourses  NutritionCourse[]
  expenses          Expense[]
  debts             Debt[]
  debtPayments      DebtPayment[]

  @@index([role])
}

// ────────────────────────────── Members ──────────────────────────────

model Member {
  id        String   @id @default(cuid())
  name      String
  gender    Gender   @default(MALE)
  age       Int?
  height    Float? // cm
  weight    Float? // kg
  // Extra body measurements (cm), collected for female members only.
  chest     Float?
  waist     Float?
  hips      Float?
  glutes    Float?
  arm       Float?
  phone     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions    Subscription[]
  trainingCourses  TrainingCourse[]
  nutritionCourses NutritionCourse[]
  notifications    Notification[]

  @@index([name])
}

// ────────────────────────────── Subscriptions ──────────────────────────────

model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         String
  durationDays Int
  price        Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Snapshot of the plan at purchase time. Active subscriptions keep their
  // original price; a renewal creates a NEW subscription at the latest price.
  planId       String?
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName     String
  durationDays Int
  price        Decimal           @db.Decimal(10, 2)

  method    PaymentMethod
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime

  // Freeze bookkeeping. Frozen days are added onto endDate.
  frozenDaysTotal Int       @default(0)
  freezeUntil     DateTime?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  freezes  FreezeRecord[]

  @@index([memberId])
  @@index([status])
  @@index([endDate])
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)
  note           String?
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

model FreezeRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  days           Int
  reason         String       @db.Text
  startedAt      DateTime     @default(now())
  endsAt         DateTime
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

// ────────────────────────────── Videos library ──────────────────────────────

model Video {
  id             String   @id @default(cuid())
  exerciseName   String
  // The real file on disk — never exposed to any client.
  storedFilename String
  originalName   String?
  mimeType       String
  sizeBytes      Int?
  // Non-guessable public token used in URLs (nanoid).
  hiddenToken    String   @unique
  addedById      String?
  addedBy        User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  exercises Exercise[]

  @@index([exerciseName])
}

// ────────────────────────────── Training courses ──────────────────────────────

model TrainingCourse {
  id         String  @id @default(cuid())
  // Templates are not tied to a member and never auto-expire.
  memberId   String?
  member     Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title      String?
  isTemplate Boolean @default(false)
  // Non-guessable token that lets the member open their own PDF without an
  // account (shared over WhatsApp). Null for templates.
  shareToken String? @unique

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  // Member courses auto-delete after 2 months; templates keep this null.
  expiresAt DateTime?

  days CourseDay[]

  @@index([memberId])
  @@index([isTemplate])
  @@index([expiresAt])
}

model CourseDay {
  id               String         @id @default(cuid())
  trainingCourseId String
  trainingCourse   TrainingCourse @relation(fields: [trainingCourseId], references: [id], onDelete: Cascade)
  label            String
  order            Int

  exercises Exercise[]

  @@index([trainingCourseId])
}

model Exercise {
  id            String    @id @default(cuid())
  courseDayId   String
  courseDay     CourseDay @relation(fields: [courseDayId], references: [id], onDelete: Cascade)
  name          String
  reps          String
  order         Int
  // Attached hidden video link (from the library). Snapshot of the token is
  // kept so copied courses / generated PDFs keep working links.
  videoId       String?
  video         Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  videoToken    String?
  // Exercises sharing the same group number within a day form a superset
  // (supports 2, 3 or more). Null = standalone exercise.
  supersetGroup Int?

  @@index([courseDayId])
}

// ────────────────────────────── Nutrition courses ──────────────────────────────

model NutritionCourse {
  id         String  @id @default(cuid())
  memberId   String
  member     Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // See TrainingCourse.shareToken.
  shareToken String? @unique

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  days NutritionDay[]

  @@index([memberId])
  @@index([expiresAt])
}

model NutritionDay {
  id                String          @id @default(cuid())
  nutritionCourseId String
  nutritionCourse   NutritionCourse @relation(fields: [nutritionCourseId], references: [id], onDelete: Cascade)
  label             String?
  order             Int

  meals NutritionMeal[]

  @@index([nutritionCourseId])
}

model NutritionMeal {
  id             String       @id @default(cuid())
  nutritionDayId String
  nutritionDay   NutritionDay @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)
  order          Int
  text           String       @db.Text

  @@index([nutritionDayId])
}

// Stored free-text meals become autocomplete suggestions next time.
model MealSuggestion {
  id         String   @id @default(cuid())
  text       String   @unique @db.VarChar(191)
  usageCount Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ────────────────────────────── Ops: log, notifications, settings ──────────────

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     ActivityAction
  details    String?        @db.Text
  targetType String?
  targetId   String?
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  type           NotificationType
  title          String
  body           String?          @db.Text
  memberId       String?
  member         Member?          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscriptionId String?
  isRead         Boolean          @default(false)
  // Prevents duplicate notifications for the same recurring condition.
  dedupeKey      String?          @unique
  createdAt      DateTime         @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value String @db.Text
}

// ────────────────────────────── Finance ──────────────────────────────

/// Money the gym spends: rent, salaries, equipment, bills…
model Expense {
  id       String          @id @default(cuid())
  title    String
  amount   Decimal         @db.Decimal(12, 2)
  category ExpenseCategory @default(OTHER)
  note     String?         @db.Text
  /// When the money actually left — may differ from when it was recorded.
  spentAt  DateTime        @default(now())

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([spentAt])
  @@index([category])
}

/// Money owed to the gym by someone who is not on a subscription plan
/// (equipment sold on credit, a guest pass, a supplier settlement…).
/// Settled in full or in instalments through DebtPayment.
model Debt {
  id         String  @id @default(cuid())
  personName String
  phone      String
  amount     Decimal @db.Decimal(12, 2)
  note       String? @db.Text

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments DebtPayment[]

  @@index([personName])
  @@index([createdAt])
}

model DebtPayment {
  id     String  @id @default(cuid())
  debtId String
  debt   Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount Decimal @db.Decimal(12, 2)
  note   String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([debtId])
  @@index([createdAt])
}
