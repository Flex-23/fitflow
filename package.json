{
  "name": "fitflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "tsx --env-file=.env prisma/reset-data.ts && npm run db:seed",
    "gate": "tsx --env-file=.env scripts/gate-bridge.ts",
    "whatsapp": "tsx --env-file=.env scripts/whatsapp-worker.ts",
    "migrate-mysql": "tsx --env-file=.env scripts/migrate-mysql-to-postgres.ts",
    "postinstall": "prisma generate",
    "gate:check": "tsx --env-file=.env scripts/gate-check.ts",
    "check:portal": "tsx --env-file=.env scripts/portal-send-check.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
